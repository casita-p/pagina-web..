    <script>
        function checkStoreStatus() {
            // Horarios:
            // Lunes a Viernes: 9:00 AM - 18:00 PM (1) a (5)
            // Sábado: Cerrado (6)
            // Domingo: 10:00 AM - 16:00 PM (0)
            
            // Usamos la hora de Ecuador (America/Guayaquil)
            const now = new Date();
            const optionsTime = { timeZone: 'America/Guayaquil', hour12: false, hour: 'numeric', minute: 'numeric', weekday: 'numeric' };
            
            // Para obtener el día y hora local exacta en Ecuador
            const ecuadorFormatter = new Intl.DateTimeFormat('en-US', {
                timeZone: 'America/Guayaquil',
                weekday: 'short',
                hour: 'numeric',
                minute: 'numeric',
                hour12: false
            });
            
            const parts = ecuadorFormatter.formatToParts(now);
            let dayStr = '';
            let hour = 0;
            let minute = 0;
            
            for (let part of parts) {
                if (part.type === 'weekday') dayStr = part.value; // Mon, Tue, Wed, Thu, Fri, Sat, Sun
                if (part.type === 'hour') hour = parseInt(part.value, 10);
                if (part.type === 'minute') minute = parseInt(part.value, 10);
            }
            
            // Mapeo de días
            // Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6
            const dayMap = { 'Sun': 0, 'Mon': 1, 'Tue': 2, 'Wed': 3, 'Thu': 4, 'Fri': 5, 'Sat': 6 };
            const dayOfWeek = dayMap[dayStr] !== undefined ? dayMap[dayStr] : now.getDay();
            
            const currentTimeVal = hour * 60 + minute;
            let isOpen = false;
            
            if (dayOfWeek >= 1 && dayOfWeek <= 5) {
                // Lunes a Viernes: 9:00 (540 min) a 18:00 (1080 min)
                if (currentTimeVal >= 540 && currentTimeVal < 1080) {
                    isOpen = true;
                }
            } else if (dayOfWeek === 0) {
                // Domingo: 10:00 (600 min) a 16:00 (960 min)
                if (currentTimeVal >= 600 && currentTimeVal < 960) {
                    isOpen = true;
                }
            }
            // Sábado (6) siempre cerrado
            
            const dotEl = document.getElementById('store-status-dot');
            const textEl = document.getElementById('store-status-text');
            
            if (isOpen) {
                dotEl.className = "w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse";
                textEl.textContent = "Abierto Ahora";
            } else {
                dotEl.className = "w-2.5 h-2.5 rounded-full bg-red-500";
                textEl.textContent = "Cerrado Ahora";
            }
        }

        // Ejecutar al cargar la página
        document.addEventListener("DOMContentLoaded", function() {
            checkStoreStatus();
            // Actualizar cada minuto por si cambia la hora
            setInterval(checkStoreStatus, 60000);
        });

        function toggleHours() {
            const dropdown = document.getElementById('hours-dropdown');
            const icon = document.getElementById('hours-icon');
            if (dropdown.classList.contains('hidden')) {
                dropdown.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                dropdown.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }

        function showCatalog(type) {
            document.getElementById('main-view').classList.add('hidden');
            document.getElementById('catalog-view').classList.remove('hidden');
            
            const sectionIphone = document.getElementById('section-iphone');
            const sectionOpenBox = document.getElementById('section-openbox');
            const sectionAppleWatch = document.getElementById('section-apple-watch');
            const sectionMacIpad = document.getElementById('section-mac-ipad');
            const sectionService = document.getElementById('section-service');

            sectionIphone.classList.add('hidden');
            sectionOpenBox.classList.add('hidden');
            sectionAppleWatch.classList.add('hidden');
            sectionMacIpad.classList.add('hidden');
            sectionService.classList.add('hidden');

            if (type === 'iphone') {
                sectionIphone.classList.remove('hidden');
            } else if (type === 'openbox') {
                sectionOpenBox.classList.remove('hidden');
            } else if (type === 'apple-watch') {
                sectionAppleWatch.classList.remove('hidden');
            } else if (type === 'mac-ipad') {
                sectionMacIpad.classList.remove('hidden');
            } else if (type === 'service') {
                sectionService.classList.remove('hidden');
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showMain() {
            document.getElementById('catalog-view').classList.add('hidden');
            document.getElementById('main-view').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>

